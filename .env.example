# Set these in your host's secure environment-variable settings. Never commit .env.local.
# Generate ADMIN_PASSWORD_HASH with: npm run admin:password
# Generate AUTH_SECRET locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
# Exact public origin including https (no path), e.g. https://your-domain.com
APP_URL=
# Required on Vercel; use a pooled PostgreSQL connection with verified TLS.
DATABASE_URL=
# Optional only for persistent-disk Node hosting. Omit when using DATABASE_URL.
# STAR_DATA_DIR=/var/lib/asteria
